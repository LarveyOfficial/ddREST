{
  "name": "ddREST",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API over the DoorDash Consumer MCP gateway, with a paste-back OAuth flow and self-renewing split-key sessions.",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "keygen": "bun scripts/keygen.ts",
    "inspect-token": "bun scripts/inspect-token.ts",
    "probe-refresh": "bun scripts/probe-refresh-lifetime.ts",
    "list-tools": "bun scripts/list-tools.ts",
    "gen-schemas": "bun scripts/gen-result-schemas.ts",
    "mock": "bun mock/upstream.ts",
    "compare-tools": "bun scripts/compare-tools.ts",
    "capture-shapes": "bun scripts/capture-shapes.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "hono": "^4.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
