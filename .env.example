# Copy to .env and fill in. Only SESSION_KEYS is required.

# --- Session store -----------------------------------------------------------
# SQLite file holding sessions. Tokens inside it are encrypted under a key that
# exists only in each client's credential, so this file alone reveals nothing.
# Running multiple API instances against one file is NOT safe -- the refresh
# coalescing is per-process, and concurrent renewals would break token chains.
SESSION_DB_PATH=./data/sessions.db

# --- Login-ticket sealing ----------------------------------------------------
# Comma-separated base64 32-byte keys. The first seals; all of them decrypt.
# These protect the short-lived login ticket only; sessions do not use them.
# Generate with: bun run keygen
# Rotate by PREPENDING a new key, redeploying, then dropping the old one once
# existing sessions have aged out. Rotating away every key logs everyone out.
SESSION_KEYS=

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8787

# --- Cookie ------------------------------------------------------------------
COOKIE_NAME=dd_session
# Leave true in any deployment. Set false ONLY for local http development.
COOKIE_SECURE=true
# Lax for a same-origin UI. None for a UI on another origin (requires
# COOKIE_SECURE=true and a populated CORS_ORIGINS).
COOKIE_SAME_SITE=Lax
# COOKIE_DOMAIN=api.example.com
COOKIE_PATH=/

# --- Cross-origin ------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser with
# credentials. Empty = no cross-origin browser access at all.
# CORS_ORIGINS=https://app.example.com
# Extra origins accepted for cookie-auth writes. Set this when running behind a
# proxy rather than relying on Host/X-Forwarded-Proto inference.
# TRUSTED_ORIGINS=https://api.example.com

# --- DoorDash ----------------------------------------------------------------
# Must be loopback on port 4180-4184 — DoorDash rejects anything else.
DD_REDIRECT_URI=http://localhost:4180/oauth2/callback
# DD_CLIENT_ID=1862661064320741379
# DD_SCOPE=mcp:consumer:write consumer:addresses:read
# DD_IDENTITY_BASE=https://identity.doordash.com
# DD_TOKEN_BASE=https://unified-gateway.doordash.com
# DD_MCP_BASE=https://openapi.doordash.com

# --- Lifetimes ---------------------------------------------------------------
# How long a pending login (the ticket from /login/start) stays redeemable.
LOGIN_TICKET_TTL_SECONDS=600
# --- Session lifetime --------------------------------------------------------
# Hard end of a session, however many times its tokens are renewed. Reaching
# this is the only thing that forces a new browser login.
#
# DoorDash imposes no cap of its own -- refresh resets the token's orig_iat, so
# a session in regular use renews indefinitely. This is therefore policy, not a
# technical limit: it bounds how long a leaked credential stays usable, which
# matters less now that logout genuinely revokes.
#
#   604800    7 days
#   2592000   30 days   (default)
#   7776000   90 days
#   31536000  365 days  -- "effectively forever"
SESSION_MAX_AGE_SECONDS=2592000

# Drop a session that has gone unused for this long, even if the cap has not
# been reached. Must be SHORTER than SESSION_MAX_AGE_SECONDS or it can never
# fire -- the server warns at startup if it cannot.
#
#   86400     1 day
#   604800    7 days
#   1209600   14 days   (default)
#   2592000   30 days
SESSION_IDLE_TIMEOUT_SECONDS=1209600

# Renew once the DoorDash access token is within this many seconds of expiring.
SESSION_REFRESH_SKEW_SECONDS=300
# How often to delete expired/idle rows.
SESSION_SWEEP_INTERVAL_SECONDS=3600
# Used only if DoorDash returns neither expires_in nor expires_at.
ASSUMED_TOKEN_TTL_SECONDS=3600
UPSTREAM_TIMEOUT_MS=30000

# --- Device pairing (RFC 8628-style) -----------------------------------------
# Lets a device with no usable browser get a session: it displays a short code,
# you approve it at /v1/auth/pair from a real computer, and the session is
# delivered to the device. Additive -- /login/start and /login/complete are
# unchanged.
#
# Only ever approve a code you can read off a device in front of you. A code
# that arrives by message or phone call is someone trying to borrow your
# account; deny it.
PAIRING_ENABLED=true

# How long a displayed code stays approvable. Must be at least 60 -- it has to
# survive a whole browser sign-in, password manager and all.
PAIRING_CODE_TTL_SECONDS=600
# Minimum seconds between a device's polls. Faster earns an RFC 8628 slow_down.
PAIRING_POLL_INTERVAL_SECONDS=5
# Ceiling on unapproved pairings, since anyone can start one.
PAIRING_MAX_PENDING=100
# Defaults next to SESSION_DB_PATH, e.g. ./data/sessions-pairings.db
# PAIRING_DB_PATH=./data/sessions-pairings.db

# --- Public address ----------------------------------------------------------
# SET THIS BEHIND A REVERSE PROXY. A paired device prints this URL on its screen
# for a human to walk to, so inferring it from the request -- which is what
# happens when this is empty -- yields an internal hostname nobody can reach.
# PUBLIC_BASE_URL=https://ddrest.example.com

# --- Defaults ----------------------------------------------------------------
# Fallback coordinates for restaurant search (dd-cli's own defaults).
DEFAULT_LATITUDE=37.3346
DEFAULT_LONGITUDE=-122.0090
